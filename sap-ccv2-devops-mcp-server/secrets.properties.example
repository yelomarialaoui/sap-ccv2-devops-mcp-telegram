# Copy to secrets.properties (git-ignored) and fill in the CCv2 technical user credentials.

sap.ccv2.api.clientId=<technical-user-client-id>
sap.ccv2.api.clientSecret=<technical-user-client-secret>

sap.ccv2.api.subscriptionCode=sap subscription code
sap.ccv2.api.tokenEndpoint=https://ycloud.accounts.ondemand.com/oauth2/token
sap.ccv2.api.resource=urn:sap:identity:application:provider:name:cp-dependency